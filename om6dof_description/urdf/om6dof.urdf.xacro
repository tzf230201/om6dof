<?xml version="1.0"?>
<!-- OM6DOF robot description -->
<robot name="om6dof" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Import all Gazebo-customization elements, including Gazebo colors -->
  <!-- Import Rviz colors -->
  <xacro:include filename="$(find om6dof_description)/urdf/materials.xacro" />
  <!-- World -->
  <link name="world">
  </link>

  <!-- World fixed joint-->
  <joint name="world_fixed" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="world"/>
    <child link="link1"/>
  </joint>

  <!-- Link 1 -->
  <link name="link1">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://om6dof_description/meshes/chain_link1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="grey"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://om6dof_description/meshes/chain_link1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>

<!--    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.082" />
      <inertia ixx="0.1" ixy="0.0" ixz="0.0"
               iyy="0.1" iyz="0.0"
               izz="0.1" />
    </inertial>-->

     <inertial>
      <origin xyz="3.0876154e-04 0.0000000e+00 -1.2176461e-04" />
      <mass value="7.9119962e-02" />
      <inertia ixx="1.2505234e-05" ixy="0.0" ixz="-1.7855208e-07"
               iyy="2.1898364e-05" iyz="0.0"
               izz="1.9267361e-05" />
    </inertial>
  </link>

  <!-- Joint 1 -->
  <joint name="joint1" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0.012 0.0 0.017" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit velocity="4.8" effort="1" lower="${-pi*0.9}" upper="${pi*0.9}" />
    <dynamics damping="0.1"/>
  </joint>
  <!--  Link 2 -->
  <link name="link2">
    <visual>
      <origin xyz="0 0 0.019" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://om6dof_description/meshes/chain_link2.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="grey"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.019" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://om6dof_description/meshes/chain_link2.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>

<!--    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.098" />
      <inertia ixx="0.1" ixy="0.0" ixz="0.0"
               iyy="0.1" iyz="0.0"
               izz="0.1" />
    </inertial>-->

     <inertial>
      <origin xyz="-3.0184870e-04 5.4043684e-04 ${0.018 + 2.9433464e-02}" />
      <mass value="9.8406837e-02" />
      <inertia ixx="3.4543422e-05" ixy="-1.6031095e-08" ixz="-3.8375155e-07"
               iyy="3.2689329e-05" iyz="2.8511935e-08"
               izz="1.8850320e-05" />
    </inertial>
  </link>

  <!--  Joint 2 -->
  <joint name="joint2" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0.0 0.0 0.0595" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit velocity="4.8" effort="1" lower="${-pi*0.65}" upper="${pi*0.67}" />
    <dynamics damping="0.1"/>
  </joint>
  <!--  Link 3 -->
  <link name="link3">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://om6dof_description/meshes/chain_link3.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="grey"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://om6dof_description/meshes/chain_link3.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>

    <inertial>
      <!-- Centre of mass from the volume centroid of chain_link3.stl (61.15 cm^3),
           taking the part as uniform density.

           It replaces 0 0 0, which put this link's mass exactly on its own joint
           axis. Across link3, link4, link5 and the two fingers that placeholder was
           hiding about 0.0218 kg m of first moment, roughly 0.21 Nm of gravity
           torque, near 18% of joint2 peak. That is the sort of error a fitted
           scale factor cannot absorb, because it is distribution, not magnitude.

           An estimate, not CAD. The implied density is well above plastic, so the
           mass almost certainly includes a servo the mesh does not draw. Better
           than the origin, worse than the real numbers link1, link2, link6 and
           link7 carry. The inertia below is still the old placeholder; gravity
           never reads it. -->
      <origin xyz="0.0 4.5e-04 9.4132e-02" />
      <mass value="0.131" />
      <inertia ixx="0.1" ixy="0.0" ixz="0.0"
               iyy="0.1" iyz="0.0"
               izz="0.1" />
    </inertial>

<!--    <inertial>
      <origin xyz="1.0308393e-02 3.7743363e-04 1.0170197e-01" />
      <mass value="1.3850917e-01" />
      <inertia ixx="3.3055381e-04" ixy="-9.7940978e-08" ixz="-3.8505711e-05"
               iyy="3.4290447e-04" iyz="-1.5717516e-06"
               izz="6.0346498e-05" />
    </inertial>-->
  </link>

  <!--  Joint 3 -->
  <joint name="joint3" type="revolute">
    <parent link="link3"/>
    <child link="link4"/>
    <origin xyz="0.0 0 0.124" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit velocity="4.8" effort="1" lower="${-pi*0.60}" upper="${pi*0.68}" />
    <dynamics damping="0.1"/>
  </joint>
  <!--  Link 4 -->
  <link name="link4">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://om6dof_description/meshes/chain_link4.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="grey"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://om6dof_description/meshes/chain_link4.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>

    <inertial>
      <!-- Centre of mass from the volume centroid of chain_link4.stl (47.44 cm^3),
           taking the part as uniform density.

           It replaces 0 0 0, which put this link's mass exactly on its own joint
           axis. Across link3, link4, link5 and the two fingers that placeholder was
           hiding about 0.0218 kg m of first moment, roughly 0.21 Nm of gravity
           torque, near 18% of joint2 peak. That is the sort of error a fitted
           scale factor cannot absorb, because it is distribution, not magnitude.

           An estimate, not CAD. The implied density is well above plastic, so the
           mass almost certainly includes a servo the mesh does not draw. Better
           than the origin, worse than the real numbers link1, link2, link6 and
           link7 carry. The inertia below is still the old placeholder; gravity
           never reads it. -->
      <origin xyz="-1.1470e-02 1.0e-05 4.3690e-02" />
      <mass value="0.098" />
      <inertia ixx="0.1" ixy="0.0" ixz="0.0"
               iyy="0.1" iyz="0.0"
               izz="0.1" />
    </inertial>

<!--     <inertial>
      <origin xyz="9.0909590e-02 3.8929816e-04 2.2413279e-04" />
      <mass value="1.3274562e-01" />
      <inertia ixx="3.0654178e-05" ixy="-1.2764155e-06" ixz="-2.6874417e-07"
               iyy="2.4230292e-04" iyz="1.1559550e-08"
               izz="2.5155057e-04" />
    </inertial>-->
  </link>

  <!--  Joint 4 -->
  <joint name="joint4" type="revolute">
    <parent link="link4"/>
    <child link="link5"/>
    <origin xyz="0.0 0.0 0.045" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit velocity="4.8" effort="1" lower="${-pi*0.9}" upper="${pi*0.9}" />
    <dynamics damping="0.1"/>
  </joint>
  <!--  Link 5 -->
  <link name="link5">
    <visual>
      <origin xyz="0 0 0.019" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://om6dof_description/meshes/chain_link5.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="grey"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.019" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://om6dof_description/meshes/chain_link5.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>

    <inertial>
      <!-- Centre of mass from the volume centroid of chain_link5.stl (45.10 cm^3),
           taking the part as uniform density.

           It replaces 0 0 0, which put this link's mass exactly on its own joint
           axis. Across link3, link4, link5 and the two fingers that placeholder was
           hiding about 0.0218 kg m of first moment, roughly 0.21 Nm of gravity
           torque, near 18% of joint2 peak. That is the sort of error a fitted
           scale factor cannot absorb, because it is distribution, not magnitude.

           An estimate, not CAD. The implied density is well above plastic, so the
           mass almost certainly includes a servo the mesh does not draw. Better
           than the origin, worse than the real numbers link1, link2, link6 and
           link7 carry. The inertia below is still the old placeholder; gravity
           never reads it. -->
      <origin xyz="0.0 6.1e-04 4.6800e-02" />
      <mass value="0.098" />
      <inertia ixx="0.1" ixy="0.0" ixz="0.0"
               iyy="0.1" iyz="0.0"
               izz="0.1" />
    </inertial>

<!--     <inertial>
      <origin xyz="4.4206755e-02 3.6839985e-07 8.9142216e-03" />
      <mass value="1.4327573e-01" />
      <inertia ixx="8.0870749e-05" ixy="0.0" ixz="-1.0157896e-06"
               iyy="7.5980465e-05" iyz="0.0"
               izz="9.3127351e-05" />
    </inertial>-->
  </link>

  <!--  Joint 5 -->
  <joint name="joint5" type="revolute">
    <parent link="link5"/>
    <child link="link6"/>
    <origin xyz="0.0 0.0 0.0595" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit velocity="4.8" effort="1" lower="${-pi*0.63}" upper="${pi*0.67}" />
    <dynamics damping="0.1"/>
  </joint>
  <!--  Link 6 -->
  <link name="link6">
    <visual>
      <origin xyz="0 0 0.0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://om6dof_description/meshes/chain_link6.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="grey"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://om6dof_description/meshes/chain_link6.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>

     <inertial>
      <!-- This link carried link7's inertial block verbatim: same mass, same centre
           of mass, same tensor, for a different part. No permutation or sign flip of
           that centre of mass lands inside chain_link6.stl, whose largest half extent
           is 28 mm against the 44.2 mm written there, so it was never link6's number
           to begin with.

           Replaced with this mesh's own volume centroid, on the same uniform-density
           assumption used on link3, link4 and link5.

           The MASS is left alone but is not trusted either: 143 g against 4.38 cm^3
           of mesh is 32.7 g/cm^3, denser than lead. Either the servo is not drawn
           here, or this was copied from link7 too. Real CAD is what settles it. -->
      <origin xyz="0.0 0.0 2.0370e-02" />
      <mass value="0.04605" />
      <inertia ixx="8.0870749e-05" ixy="0.0" ixz="-1.0157896e-06"
               iyy="7.5980465e-05" iyz="0.0"
               izz="9.3127351e-05" />
    </inertial>
  </link>

  <!--  Joint 6 -->
  <joint name="joint6" type="revolute">
    <parent link="link6"/>
    <child link="link7"/>
    <origin xyz="0.0 0.0 0.0475" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit velocity="4.8" effort="1" lower="${-pi*0.9}" upper="${pi*0.9}" />
    <dynamics damping="0.1"/>
  </joint>
  <!--  Link 7 -->
  <link name="link7">
    <visual>
      <origin xyz="0 0 0.0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://om6dof_description/meshes/chain_link7.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="grey"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://om6dof_description/meshes/chain_link7.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>

     <inertial>
      <!-- x and z were swapped here. Ray-cast against chain_link7.stl: the value as
           written, 44.2 mm along +X, falls outside the body entirely, and of every
           permutation and sign flip of the three numbers only those putting 44.2 on
           Z land inside it. Keeping y as the near-zero component is the single-swap
           reading and the one consistent with a symmetric part. -->
      <origin xyz="-8.9142216e-03 3.6839985e-07 ${0.5*4.4206755e-02}" />
      <mass value="0.22527573" />
      <inertia ixx="8.0870749e-05" ixy="0.0" ixz="-1.0157896e-06"
               iyy="7.5980465e-05" iyz="0.0"
               izz="9.3127351e-05" />
    </inertial>
  </link>

  <!--  Gripper link -->
  <link name="gripper_left_link">
    <visual>
      <origin xyz="0.0 0.0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://om6dof_description/meshes/chain_link_grip_l.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="grey"/>
    </visual>

    <collision>
      <origin xyz="0.0 0.0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://om6dof_description/meshes/chain_link_grip_l.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>

    <inertial>
      <!-- Centre of mass from the volume centroid of the gripper mesh (27.19 cm^3),
           taking the part as uniform density.

           It replaces 0 0 0, which put this link's mass exactly on its own joint
           axis. Across link3, link4, link5 and the two fingers that placeholder was
           hiding about 0.0218 kg m of first moment, roughly 0.21 Nm of gravity
           torque, near 18% of joint2 peak. That is the sort of error a fitted
           scale factor cannot absorb, because it is distribution, not magnitude.

           An estimate, not CAD. The implied density is well above plastic, so the
           mass almost certainly includes a servo the mesh does not draw. Better
           than the origin, worse than the real numbers link1, link2, link6 and
           link7 carry. The inertia below is still the old placeholder; gravity
           never reads it. -->
      <origin xyz="0.0 9.3200e-03 1.0080e-02" />
      <mass value="0.017" />
      <inertia ixx="1.0e-03" ixy="0.0" ixz="0.0"
               iyy="1.0e-03" iyz="0.0"
               izz="1.0e-03" />
    </inertial>

<!--     <inertial>
      <origin xyz="${0.028 + 8.3720668e-03} ${0.0246 + 9.9696160e-03} -4.2836895e-07" />
      <mass value="3.2218127e-02" />
      <inertia ixx="9.5568826e-06" ixy="2.8424644e-06" ixz="-3.2829197e-10"
               iyy="2.2552871e-05" iyz="-3.1463634e-10"
               izz="1.7605306e-05" />
    </inertial>-->
  </link>

  <!--  Gripper joint -->
  <joint name="gripper_left_joint" type="prismatic">
    <parent link="link7"/>
    <child link="gripper_left_link"/>
    <origin xyz="0.0 0.021 0.0707" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit velocity="4.8" effort="1000" lower="-0.011" upper="0.020" />
    <dynamics damping="0.1"/>
  </joint>
  <!--  Gripper link sub -->
  <link name="gripper_right_link">
    <visual>
      <origin xyz="0.0 -0.0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://om6dof_description/meshes/chain_link_grip_r.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="grey"/>
    </visual>

    <collision>
      <origin xyz="0.0 -0.0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://om6dof_description/meshes/chain_link_grip_r.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>

    <inertial>
      <!-- Centre of mass from the volume centroid of the gripper mesh (27.22 cm^3),
           taking the part as uniform density.

           It replaces 0 0 0, which put this link's mass exactly on its own joint
           axis. Across link3, link4, link5 and the two fingers that placeholder was
           hiding about 0.0218 kg m of first moment, roughly 0.21 Nm of gravity
           torque, near 18% of joint2 peak. That is the sort of error a fitted
           scale factor cannot absorb, because it is distribution, not magnitude.

           An estimate, not CAD. The implied density is well above plastic, so the
           mass almost certainly includes a servo the mesh does not draw. Better
           than the origin, worse than the real numbers link1, link2, link6 and
           link7 carry. The inertia below is still the old placeholder; gravity
           never reads it. -->
      <origin xyz="0.0 -9.3200e-03 1.0070e-02" />
      <mass value="0.017" />
      <inertia ixx="1.0e-03" ixy="0.0" ixz="0.0"
               iyy="1.0e-03" iyz="0.0"
               izz="1.0e-03" />
    </inertial>

<!--     <inertial>
      <origin xyz="${0.028 + 8.3720668e-03} ${-0.0246 - 9.9696160e-03} -4.2836895e-07" />
      <mass value="3.2218127e-02" />
      <inertia ixx="9.5568826e-06" ixy="2.8424644e-06" ixz="-3.2829197e-10"
               iyy="2.2552871e-05" iyz="-3.1463634e-10"
               izz="1.7605306e-05" />
    </inertial>-->
  </link>

  <!--  Gripper joint sub -->
  <joint name="gripper_right_joint" type="prismatic">
    <parent link="link7"/>
    <child link="gripper_right_link"/>
    <origin xyz="0.0 -0.021 0.0707" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit velocity="4.8" effort="1000" lower="-0.011" upper="0.020" />
    <dynamics damping="0.7"/>
    <mimic joint="gripper_left_joint" multiplier="1"/>
  </joint>
  <!-- end effector joint -->
  <joint name="end_effector_joint" type="fixed">
    <origin xyz="0.0 0.0 0.115" rpy="0 0 0"/>
    <parent link="link7"/>
    <child link="end_effector_link"/>
  </joint>

  <!-- end effector link -->
  <link name="end_effector_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.01 0.01 0.01" />
      </geometry>
      <material name="red"/>
     </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.01 0.01 0.01"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <mass value="0.001"/>
      <inertia ixx="1.0e-06" ixy="0.0" ixz="0.0" iyy="1.0e-06" iyz="0.0" izz="1.0e-06" />
    </inertial>
  </link>

  <!-- ==================== wrist payload (RealSense D405) ====================
       Measured values live in config/payload.yaml, never here, so one edit
       reaches every consumer: robot_state_publisher, the IK solver, and the
       gravity model all render this same file.

       Parent is end_effector_link deliberately. It is the tip of the chain the
       gravity model builds (link1 -> end_effector_link), so the payload's
       centre of mass needs no rotation to reach the frame the mass is folded
       into: the number measured is the number used. It is also a point that
       can be found on the real robot: the tool point between the fingers.

       The inertial block appears only once a mass has been measured. With
       mass still 0.0 the link is a bare frame, visible in TF as a mounting
       reference, contributing exactly nothing to the dynamics.
  -->
  <xacro:property name="payload_cfg"
                  value="${xacro.load_yaml('$(find om6dof_description)/config/payload.yaml')}"/>
  <xacro:property name="payload" value="${payload_cfg['payload']}"/>
  <xacro:property name="payload_mass" value="${float(payload['mass'])}"/>

  <!-- ============ wrist camera: D405 + ALOHA bracket, one body ============
       Pose derived from the meshes, not estimated. d405_wrist_cam.stl carries
       four M3 holes on a 12 x 16 mm grid in the plane y = 27.20, centred on
       (-19.1, 27.2, 75.5). chain_link7.stl has a flat face at x = -35.3 mm
       with the same grid as 16 (y) x 12 (z), centred on (y,z) = (0, 34).
       Only one pairing of those grids fits, which fixes the rotation; the
       remaining 180 degree choice about the bolt axis was settled against a
       photograph of the real arm.

       The X offset is -38.0 mm, not the -35.3 mm the hole plane sits at.
       -35.3 is the counterbore floor the M3 heads drop into; link7's real
       outer surface is at -37.8, and the bracket foot rests on that surface.
       Measured on the hardware, not derived: mating the hole planes would
       sink the foot 2.5 mm into the wrist. At -38.0 the foot clears the
       outer surface by 0.20 mm with no interpenetration.

       This link's origin is the CENTRE OF THE FOUR SCREWS, deliberately.
       That is a point you can find with a ruler on the real robot, so the
       payload centre of mass in config/payload.yaml is measured from
       something real rather than from a CAD origin nobody can see.
       The visual is therefore shifted by -(-19.1, 27.2, 75.5) mm to bring the
       mesh's own frame onto that point.
  -->
  <joint name="d405_payload_joint" type="fixed">
    <origin xyz="-0.038 0.0 ${0.0340 + float(payload['mount_offset_z'])}"
            rpy="${pi} ${-pi/2} ${-pi/2}"/>
    <parent link="link7"/>
    <child link="d405_payload_link"/>
  </joint>

  <link name="d405_payload_link">
    <visual>
      <origin xyz="0.0191 -0.0272 -0.0755" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://om6dof_description/meshes/d405_wrist_cam.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="white"/>
    </visual>
    <xacro:if value="${payload_mass > 0.0}">
      <!-- Solid sphere: valid for any mass, and gravity reads none of it. -->
      <xacro:property name="payload_i"
                      value="${0.4 * payload_mass * float(payload['inertia_radius'])**2}"/>
      <inertial>
        <origin xyz="${payload['com'][0]} ${payload['com'][1]} ${payload['com'][2]}"
                rpy="0 0 0"/>
        <mass value="${payload_mass}"/>
        <inertia ixx="${payload_i}" ixy="0.0" ixz="0.0"
                 iyy="${payload_i}" iyz="0.0" izz="${payload_i}"/>
      </inertial>
    </xacro:if>
  </link>

  <!-- ============ D405 optical frame: d405_link, d405_depth_optical_frame ============
       Everything above (d405_payload_link) places the ALOHA bracket + camera as one fused
       STL. This section locates two more frames INSIDE that assembly: the camera's own body
       frame (d405_link) and the depth optical frame tf2/RViz/librealsense-adjacent code
       expects (z forward into the scene, x right, y down; REP 103 optical convention).

       METHOD, splitting the fused mesh:
       d405_wrist_cam.stl decomposes into exactly two disjoint shells by connected components
       (union-find over shared vertices, since the bracket and camera don't touch): 19.32 cm^3
       (the bracket) and 38.73 cm^3. The second is byte-for-byte the same geometry as
       meshes/d405.stl: same 4630 triangles, same 38.73 cm^3, same triangle order, so that
       file is the bare D405 camera body on its own, and the assembly contains one unmodified,
       rigidly-placed copy of it. Kabsch/SVD alignment of that shell's 13890 vertices against
       d405.stl's own vertices (both already in matching order, so vertex i corresponds to
       vertex i, no nearest-neighbour search needed) recovers the placement to sub-micron
       residual (max 5.9e-6 mm over 13890 points): not a noisy fit, effectively reading the
       exact rigid transform back out of the file. A point given in d405.stl's own frame (mm)
       maps through a fitted rotation R and translation t to the same point in the raw
       d405_wrist_cam.stl frame (mm): the same frame the visual mesh origin above is stated in.
       Composing t with that visual origin's shift (+19.1,-27.2,-75.5 mm, the same constant
       used above) gives d405_link's origin in the d405_payload_link frame; R (pure rotation,
       untouched by translation) gives its orientation directly. (Script: SVD/Kabsch alignment
       of the two meshes, run once during this integration; not checked in.)

       ORIENTATION SIGN, which way d405_link's +Z points:
       d405.stl's own frame does not self-label which flat 42x42 end is the lens side and
       which is the connector side: both end caps are otherwise plain, and the only
       asymmetric feature found (two holes 18 mm apart, symmetric about the centerline, at
       one extreme) could honestly be either the two imager lenses (18 mm matches the D405
       baseline, Table 3-49 of the Intel D400 datasheet, doc 337029-017) or the two M3x0.5
       mounting inserts on the back panel (Figure 4-9, same document). Rather than guess, the
       sign was fixed by the one fact that has to hold regardless of mesh cosmetics: a wrist
       camera must look away from the arm, roughly toward end_effector_link (link7 +Z), not
       back into it. Of the two candidate directions +/-Z of d405.stl's own frame, local +Z
       lands 25.0 deg off link7's +Z once carried through this whole chain; the other
       candidate lands 155.0 deg off, looking back into the arm. So local +Z of d405.stl is
       "forward" (into the scene), which also fixes local Z=0 as the front glass plane (the
       housing only occupies local z in [-23, 0] mm).
       This is the same kind of 180 degree call the bracket rotation above settled with a
       photograph; no such photograph of the assembled camera exists here, so this is the next
       best evidence available. If the world-frame point cloud is later seen to rotate or
       drift as the wrist reorients, rather than sitting still (which is the actual M2
       acceptance test), suspect this sign first.

       DEPTH ORIGIN, where along that axis:
       Table 4-16 (Figure 4-4) gives the D405 "Depth Start Point" as 3.7 mm behind the front
       cover glass, i.e. 3.7 mm in local -Z from d405_link's origin. Table 4-21 places the
       left imager 9 mm off the housing centerline (half of the 18 mm baseline), but which
       side is "left" is not recoverable from this mesh (both end faces are bilaterally
       symmetric in it; unlike the bracket rotation there is no photo of the assembled camera
       to check against). That 9 mm is left off (optical frame kept on the centerline) rather
       than guessing its sign: it only shifts the drawn TF pose in RViz, never the
       reconstructed point cloud, because the perception node deprojects with librealsense's
       own live intrinsics (fx, fy, ppx, ppy read from the camera at runtime), not this static
       offset.

       d405_depth_optical_frame's rotation relative to d405_link is left as identity: baseline
       (d405.stl local X) lands within 0.012 deg of link7's own +Y axis, and forward (local Z)
       within 25 deg of link7's +Z, exactly what X-right/Y-down/Z-forward should look like if
       d405.stl's mesh axes were already authored in that convention, which is plausible for a
       mesh sourced for URDF/ROS use. Like the 9 mm above, this is not verified against the
       real hardware's markings.
  -->
  <joint name="d405_link_joint" type="fixed">
    <origin xyz="0.010093 0.047231 0.000046" rpy="-1.134465 1.570590 -1.570798"/>
    <parent link="d405_payload_link"/>
    <child link="d405_link"/>
  </joint>
  <link name="d405_link"/>

  <joint name="d405_depth_optical_joint" type="fixed">
    <!-- -0.0037 m: Table 4-16 "Depth Start Point" for D405, 3.7 mm behind the front cover
         glass (local -Z, back toward the sensor); see the derivation above. -->
    <origin xyz="0 0 -0.0037" rpy="0 0 0"/>
    <parent link="d405_link"/>
    <child link="d405_depth_optical_frame"/>
  </joint>
  <link name="d405_depth_optical_frame"/>

</robot>
