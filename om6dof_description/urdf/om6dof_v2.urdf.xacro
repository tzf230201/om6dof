<?xml version="1.0"?>
<!-- OM6DOF v2 robot description: link3 uses chain_link3_v2.stl. -->
<!--
  SPDX-License-Identifier: Apache-2.0
  Derived from ROBOTIS-GIT/open_manipulator_friends,
  open_manipulator_6dof_description/urdf/open_manipulator_6dof.urdf.xacro.
  Modified by OM6DOF maintainers: ROS 2/package integration, inertial
  parameters, joint limits, base/end-effector and gripper configuration,
  pedestal, and wrist-mounted RealSense camera/payload frames.
  The v2 variant replaces link3's visual and collision mesh with the local
  chain_link3_v2.stl asset. Unlike the original millimetre STL, this mesh is
  authored in metres and its Z origin is 80 mm above its lower edge. Its v2
  visual/collision origins therefore use unit scale and a -82.5 mm Z offset to
  align the lower edge with the original mesh. Joint and link names remain
  compatible with OM6DOF.
  See the accompanying LICENSE and NOTICE for terms and upstream credits.
-->
<robot name="om6dof_v2" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Import all Gazebo-customization elements, including Gazebo colors -->
  <!-- Import Rviz colors -->
  <xacro:include filename="$(find om6dof_description)/urdf/materials.xacro" />
  <!-- Pedestal from the ground/table plane to the bottom of the base servo. -->
  <xacro:property name="base_height" value="0.020"/>
  <!-- Align the metre-native v2 link3 mesh to the original link3 mesh frame.
       The v2 mounting geometry is 20 mm positive-X of the old mesh datum;
       its lower Z edge remains aligned to the original mesh. -->
  <xacro:property name="link3_v2_x_offset" value="0.021"/>
  <xacro:property name="link3_v2_y_offset" value="0.0"/>
  <xacro:property name="link3_v2_z_offset" value="-0.0825"/>
  <!-- The output mounting-hole centre of the v2 geometry.  It replaces the
       original link3 -> link4 joint datum of X=0 mm, Z=124 mm.  Values are
       measured from the concentric output-hole geometry in the STL. -->
  <xacro:property name="link3_v2_joint3_x" value="0.023"/>
  <xacro:property name="link3_v2_joint3_z" value="0.128"/>
  <!-- Move the complete link4 branch forward in link3's +X direction.  Unlike
       joint4, this moves link4, its horn, and all downstream links together. -->
  <xacro:property name="link3_v2_link4_forward_x_offset" value="0.001"/>
  <!-- Link4 mounts perpendicular to link3 on the v2 output interface. -->
  <xacro:property name="link3_v2_joint3_mount_pitch" value="${pi / 2.0}"/>

  <!-- World -->
  <link name="world">
  </link>

  <!-- A 20 mm support keeps the bottom of the link1/base servo above ground. -->
  <link name="base_link">
    <visual>
      <!-- link1 footprint is approximately 46.5 x 28.5 mm; leave a 1.75 mm rim. -->
      <origin xyz="0 0 ${base_height / 2.0}" rpy="0 0 0"/>
      <geometry>
        <box size="0.050 0.032 ${base_height}"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <!-- Deliberately visual-only: the pedestal is fixed to the table plane,
         so collision geometry here would permanently contact the table object
         in MoveIt's planning scene. -->
  </link>

  <!-- World fixed joint: ground/table plane -> 20 mm pedestal. -->
  <joint name="world_fixed" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="world"/>
    <child link="base_link"/>
  </joint>

  <!-- Pedestal top -> bottom of the base servo (link1). -->
  <joint name="base_to_link1" type="fixed">
    <origin xyz="0 0 ${base_height}" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="link1"/>
  </joint>

  <!-- Link 1 -->
  <link name="link1">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://om6dof_description/meshes/chain_link1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="grey"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://om6dof_description/meshes/chain_link1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>

<!--    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.082" />
      <inertia ixx="0.1" ixy="0.0" ixz="0.0"
               iyy="0.1" iyz="0.0"
               izz="0.1" />
    </inertial>-->

     <inertial>
      <origin xyz="3.0876154e-04 0.00 0.018" />
      <mass value="7.9119962e-02" />
      <inertia ixx="1.2505234e-05" ixy="0.0" ixz="-1.7855208e-07"
               iyy="2.1898364e-05" iyz="0.0"
               izz="1.9267361e-05" />
    </inertial>
  </link>

  <!-- Joint 1 -->
  <joint name="joint1" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0.012 0.0 0.017" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit velocity="4.8" effort="1" lower="${-pi*0.5}" upper="${pi*0.5}" />
    <dynamics damping="0.1"/>
  </joint>
  <!--  Link 2 -->
  <link name="link2">
    <visual>
      <origin xyz="0 0 0.019" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://om6dof_description/meshes/chain_link2.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="grey"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.019" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://om6dof_description/meshes/chain_link2.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>

<!--    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.098" />
      <inertia ixx="0.1" ixy="0.0" ixz="0.0"
               iyy="0.1" iyz="0.0"
               izz="0.1" />
    </inertial>-->

     <inertial>
      <origin xyz="-3.0184870e-04 5.4043684e-04 ${0.018 + 2.9433464e-02}" />
      <mass value="9.8406837e-02" />
      <inertia ixx="3.4543422e-05" ixy="-1.6031095e-08" ixz="-3.8375155e-07"
               iyy="3.2689329e-05" iyz="2.8511935e-08"
               izz="1.8850320e-05" />
    </inertial>
  </link>

  <!--  Joint 2 -->
  <joint name="joint2" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0.0 0.0 0.0595" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit velocity="4.8" effort="1" lower="${-pi*0.65}" upper="${pi*0.67}" />
    <dynamics damping="0.1"/>
  </joint>
  <!--  Link 3 -->
  <link name="link3">
    <visual>
      <!-- v2 mesh: native metres; align its z=80 mm lower edge to the
           original mesh's z=-2.5 mm lower edge. -->
      <origin xyz="${link3_v2_x_offset} ${link3_v2_y_offset} ${link3_v2_z_offset}" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://om6dof_description/meshes/chain_link3_v2.stl" scale="1 1 1"/>
      </geometry>
      <material name="grey"/>
    </visual>

    <collision>
      <origin xyz="${link3_v2_x_offset} ${link3_v2_y_offset} ${link3_v2_z_offset}" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://om6dof_description/meshes/chain_link3_v2.stl" scale="1 1 1"/>
      </geometry>
    </collision>

    <inertial>
      <!-- The v2 mesh changes only visual and collision geometry.  These inertial
           values are retained from the original link3 model and have not been
           recalculated from chain_link3_v2.stl.

           Centre of mass from the volume centroid of chain_link3.stl (61.15 cm^3),
           taking the part as uniform density.

           It replaces 0 0 0, which put this link's mass exactly on its own joint
           axis. Across link3, link4, link5 and the two fingers that placeholder was
           hiding about 0.0218 kg m of first moment, roughly 0.21 Nm of gravity
           torque, near 18% of joint2 peak. That is the sort of error a fitted
           scale factor cannot absorb, because it is distribution, not magnitude.

           An estimate, not CAD. The implied density is well above plastic, so the
           mass almost certainly includes a servo the mesh does not draw. Better
           than the origin, worse than the real numbers link1, link2, link6 and
           link7 carry. The inertia below is still the old placeholder; gravity
           never reads it. -->
      <origin xyz="0.0 4.5e-04 9.4132e-02" />
      <mass value="0.1385" />
      <inertia ixx="0.1" ixy="0.0" ixz="0.0"
               iyy="0.1" iyz="0.0"
               izz="0.1" />
    </inertial>

<!--    <inertial>
      <origin xyz="1.0308393e-02 3.7743363e-04 1.0170197e-01" />
      <mass value="1.3850917e-01" />
      <inertia ixx="3.3055381e-04" ixy="-9.7940978e-08" ixz="-3.8505711e-05"
               iyy="3.4290447e-04" iyz="-1.5717516e-06"
               izz="6.0346498e-05" />
    </inertial>-->
  </link>

  <!--  Joint 3 -->
  <joint name="joint3" type="revolute">
    <parent link="link3"/>
    <child link="link4"/>
    <!-- V2 link3 output-hole centre: X=23 mm, Z=128 mm; link4 mounts
         perpendicular to link3 (+90 degrees around the Y joint axis), then
         receives a +1 mm branch-level forward fitting offset. -->
    <origin xyz="${link3_v2_joint3_x + link3_v2_link4_forward_x_offset} 0 ${link3_v2_joint3_z}" rpy="0 ${link3_v2_joint3_mount_pitch} 0"/>
    <axis xyz="0 1 0"/>
    <limit velocity="4.8" effort="1" lower="${-pi*0.5}" upper="${pi*0.47}" />
    <dynamics damping="0.1"/>
  </joint>
  <!--  Link 4 -->
  <link name="link4">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://om6dof_description/meshes/chain_link4.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="grey"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://om6dof_description/meshes/chain_link4.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>

    <inertial>
      <!-- Centre of mass from the volume centroid of chain_link4.stl (47.44 cm^3),
           taking the part as uniform density.

           It replaces 0 0 0, which put this link's mass exactly on its own joint
           axis. Across link3, link4, link5 and the two fingers that placeholder was
           hiding about 0.0218 kg m of first moment, roughly 0.21 Nm of gravity
           torque, near 18% of joint2 peak. That is the sort of error a fitted
           scale factor cannot absorb, because it is distribution, not magnitude.

           An estimate, not CAD. The implied density is well above plastic, so the
           mass almost certainly includes a servo the mesh does not draw. Better
           than the origin, worse than the real numbers link1, link2, link6 and
           link7 carry. The inertia below is still the old placeholder; gravity
           never reads it. -->
      <origin xyz="-1.1470e-02 1.0e-05 4.3690e-02" />
      <mass value="0.098" />
      <inertia ixx="0.1" ixy="0.0" ixz="0.0"
               iyy="0.1" iyz="0.0"
               izz="0.1" />
    </inertial>

<!--     <inertial>
      <origin xyz="9.0909590e-02 3.8929816e-04 2.2413279e-04" />
      <mass value="1.3274562e-01" />
      <inertia ixx="3.0654178e-05" ixy="-1.2764155e-06" ixz="-2.6874417e-07"
               iyy="2.4230292e-04" iyz="1.1559550e-08"
               izz="2.5155057e-04" />
    </inertial>-->
  </link>

  <!--  Joint 4 -->
  <joint name="joint4" type="revolute">
    <parent link="link4"/>
    <child link="link5"/>
    <!-- Original link4 horn datum.  Moving this origin would move child link5,
         not the horn that belongs to link4. -->
    <origin xyz="0.0 0.0 0.045" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit velocity="4.8" effort="1" lower="${-pi*0.4}" upper="${pi*0.4}" />
    <dynamics damping="0.1"/>
  </joint>
  <!--  Link 5 -->
  <link name="link5">
    <visual>
      <origin xyz="0 0 0.019" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://om6dof_description/meshes/chain_link5.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="grey"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.019" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://om6dof_description/meshes/chain_link5.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>

    <inertial>
      <!-- Centre of mass from the volume centroid of chain_link5.stl (45.10 cm^3),
           taking the part as uniform density.

           It replaces 0 0 0, which put this link's mass exactly on its own joint
           axis. Across link3, link4, link5 and the two fingers that placeholder was
           hiding about 0.0218 kg m of first moment, roughly 0.21 Nm of gravity
           torque, near 18% of joint2 peak. That is the sort of error a fitted
           scale factor cannot absorb, because it is distribution, not magnitude.

           An estimate, not CAD. The implied density is well above plastic, so the
           mass almost certainly includes a servo the mesh does not draw. Better
           than the origin, worse than the real numbers link1, link2, link6 and
           link7 carry. The inertia below is still the old placeholder; gravity
           never reads it. -->
      <origin xyz="0.0 6.1e-04 4.6800e-02" />
      <mass value="0.098" />
      <inertia ixx="0.1" ixy="0.0" ixz="0.0"
               iyy="0.1" iyz="0.0"
               izz="0.1" />
    </inertial>

<!--     <inertial>
      <origin xyz="4.4206755e-02 3.6839985e-07 8.9142216e-03" />
      <mass value="1.4327573e-01" />
      <inertia ixx="8.0870749e-05" ixy="0.0" ixz="-1.0157896e-06"
               iyy="7.5980465e-05" iyz="0.0"
               izz="9.3127351e-05" />
    </inertial>-->
  </link>

  <!--  Joint 5 -->
  <joint name="joint5" type="revolute">
    <parent link="link5"/>
    <child link="link6"/>
    <origin xyz="0.0 0.0 0.0595" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit velocity="4.8" effort="1" lower="${-pi*0.5}" upper="${pi*0.67}" />
    <dynamics damping="0.1"/>
  </joint>
  <!--  Link 6 -->
  <link name="link6">
    <visual>
      <origin xyz="0 0 0.0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://om6dof_description/meshes/chain_link6.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="grey"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://om6dof_description/meshes/chain_link6.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>

     <inertial>
      <!-- This link carried link7's inertial block verbatim: same mass, same centre
           of mass, same tensor, for a different part. No permutation or sign flip of
           that centre of mass lands inside chain_link6.stl, whose largest half extent
           is 28 mm against the 44.2 mm written there, so it was never link6's number
           to begin with.

           Replaced with this mesh's own volume centroid, on the same uniform-density
           assumption used on link3, link4 and link5.

           The MASS is left alone but is not trusted either: 143 g against 4.38 cm^3
           of mesh is 32.7 g/cm^3, denser than lead. Either the servo is not drawn
           here, or this was copied from link7 too. Real CAD is what settles it. -->
      <origin xyz="0.0 0.0 2.0370e-02" />
      <mass value="0.04605" />
      <inertia ixx="8.0870749e-05" ixy="0.0" ixz="-1.0157896e-06"
               iyy="7.5980465e-05" iyz="0.0"
               izz="9.3127351e-05" />
    </inertial>
  </link>

  <!--  Joint 6 -->
  <joint name="joint6" type="revolute">
    <parent link="link6"/>
    <child link="link7"/>
    <origin xyz="0.0 0.0 0.0475" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit velocity="4.8" effort="1" lower="${-pi*0.5}" upper="${pi*0.5}" />
    <dynamics damping="0.1"/>
  </joint>
  <!--  Link 7 -->
  <link name="link7">
    <visual>
      <origin xyz="0 0 0.0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://om6dof_description/meshes/chain_link7.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="grey"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://om6dof_description/meshes/chain_link7.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>

     <inertial>
      <!-- x and z were swapped here. Ray-cast against chain_link7.stl: the value as
           written, 44.2 mm along +X, falls outside the body entirely, and of every
           permutation and sign flip of the three numbers only those putting 44.2 on
           Z land inside it. Keeping y as the near-zero component is the single-swap
           reading and the one consistent with a symmetric part. -->
      <origin xyz="-8.9142216e-03 3.6839985e-07 ${0.5*4.4206755e-02}" />
      <mass value="0.22527573" />
      <inertia ixx="8.0870749e-05" ixy="0.0" ixz="-1.0157896e-06"
               iyy="7.5980465e-05" iyz="0.0"
               izz="9.3127351e-05" />
    </inertial>
  </link>

  <!--  Gripper link -->
  <link name="gripper_left_link">
    <visual>
      <origin xyz="0.0 0.0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://om6dof_description/meshes/chain_link_grip_l.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="grey"/>
    </visual>

    <collision>
      <origin xyz="0.0 0.0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://om6dof_description/meshes/chain_link_grip_l.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>

    <inertial>
      <!-- Centre of mass from the volume centroid of the gripper mesh (27.19 cm^3),
           taking the part as uniform density.

           It replaces 0 0 0, which put this link's mass exactly on its own joint
           axis. Across link3, link4, link5 and the two fingers that placeholder was
           hiding about 0.0218 kg m of first moment, roughly 0.21 Nm of gravity
           torque, near 18% of joint2 peak. That is the sort of error a fitted
           scale factor cannot absorb, because it is distribution, not magnitude.

           An estimate, not CAD. The implied density is well above plastic, so the
           mass almost certainly includes a servo the mesh does not draw. Better
           than the origin, worse than the real numbers link1, link2, link6 and
           link7 carry. The inertia below is still the old placeholder; gravity
           never reads it. -->
      <origin xyz="0.0 9.3200e-03 1.0080e-02" />
      <mass value="0.017" />
      <inertia ixx="1.0e-03" ixy="0.0" ixz="0.0"
               iyy="1.0e-03" iyz="0.0"
               izz="1.0e-03" />
    </inertial>

<!--     <inertial>
      <origin xyz="${0.028 + 8.3720668e-03} ${0.0246 + 9.9696160e-03} -4.2836895e-07" />
      <mass value="3.2218127e-02" />
      <inertia ixx="9.5568826e-06" ixy="2.8424644e-06" ixz="-3.2829197e-10"
               iyy="2.2552871e-05" iyz="-3.1463634e-10"
               izz="1.7605306e-05" />
    </inertial>-->
  </link>

  <!--  Gripper joint -->
  <joint name="gripper_left_joint" type="prismatic">
    <parent link="link7"/>
    <child link="gripper_left_link"/>
    <origin xyz="0.0 0.021 0.0707" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit velocity="4.8" effort="1000" lower="-0.011" upper="0.020" />
    <dynamics damping="0.1"/>
  </joint>
  <!--  Gripper link sub -->
  <link name="gripper_right_link">
    <visual>
      <origin xyz="0.0 -0.0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://om6dof_description/meshes/chain_link_grip_r.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="grey"/>
    </visual>

    <collision>
      <origin xyz="0.0 -0.0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://om6dof_description/meshes/chain_link_grip_r.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>

    <inertial>
      <!-- Centre of mass from the volume centroid of the gripper mesh (27.22 cm^3),
           taking the part as uniform density.

           It replaces 0 0 0, which put this link's mass exactly on its own joint
           axis. Across link3, link4, link5 and the two fingers that placeholder was
           hiding about 0.0218 kg m of first moment, roughly 0.21 Nm of gravity
           torque, near 18% of joint2 peak. That is the sort of error a fitted
           scale factor cannot absorb, because it is distribution, not magnitude.

           An estimate, not CAD. The implied density is well above plastic, so the
           mass almost certainly includes a servo the mesh does not draw. Better
           than the origin, worse than the real numbers link1, link2, link6 and
           link7 carry. The inertia below is still the old placeholder; gravity
           never reads it. -->
      <origin xyz="0.0 -9.3200e-03 1.0070e-02" />
      <mass value="0.017" />
      <inertia ixx="1.0e-03" ixy="0.0" ixz="0.0"
               iyy="1.0e-03" iyz="0.0"
               izz="1.0e-03" />
    </inertial>

<!--     <inertial>
      <origin xyz="${0.028 + 8.3720668e-03} ${-0.0246 - 9.9696160e-03} -4.2836895e-07" />
      <mass value="3.2218127e-02" />
      <inertia ixx="9.5568826e-06" ixy="2.8424644e-06" ixz="-3.2829197e-10"
               iyy="2.2552871e-05" iyz="-3.1463634e-10"
               izz="1.7605306e-05" />
    </inertial>-->
  </link>

  <!--  Gripper joint sub -->
  <joint name="gripper_right_joint" type="prismatic">
    <parent link="link7"/>
    <child link="gripper_right_link"/>
    <origin xyz="0.0 -0.021 0.0707" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit velocity="4.8" effort="1000" lower="-0.011" upper="0.020" />
    <dynamics damping="0.7"/>
    <mimic joint="gripper_left_joint" multiplier="1"/>
  </joint>
  <!-- end effector joint -->
  <joint name="end_effector_joint" type="fixed">
    <origin xyz="0.0 0.0 0.115" rpy="0 0 0"/>
    <parent link="link7"/>
    <child link="end_effector_link"/>
  </joint>

  <!-- end effector link -->
  <link name="end_effector_link">
    <!-- Coordinate/inertial frame only. The former 10 mm red cube was a
         debug glyph, not measured hardware, and made MoveIt collide against
         a phantom object at the TCP. The finger links contain the physical
         gripper visual/collision meshes. -->
    <inertial>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <mass value="0.001"/>
      <inertia ixx="1.0e-06" ixy="0.0" ixz="0.0" iyy="1.0e-06" iyz="0.0" izz="1.0e-06" />
    </inertial>
  </link>

  <!-- ==================== wrist payload (RealSense D435) ====================
       V2-only component masses and estimated CAD-frame centres of mass live
       in config/payload_d435.yaml. The original D405 model is unchanged.
       Combine centres by mass, then subtract the visual's CAD datum so the
       inertia and mesh use the same payload frame. This branch is on link7;
       consumers must account for its fixed-joint transform when folding mass.
  -->
  <xacro:property name="payload_cfg"
                  value="${xacro.load_yaml('$(find om6dof_description)/config/payload_d435.yaml')}"/>
  <xacro:property name="payload" value="${payload_cfg['payload']}"/>
  <xacro:property name="camera_mass" value="${float(payload['camera_mass'])}"/>
  <xacro:property name="bracket_mass" value="${float(payload['bracket_mass'])}"/>
  <xacro:property name="payload_mass" value="${camera_mass + bracket_mass}"/>

  <!-- D435 wrist bracket mounting, measured from the local STL (millimetres):
       Two through-hole axes run along CAD Y at (X,Z)=(51.870518,31.075)
       and (51.870518,47.075). Their spacing is 16 mm.
       The selected link7 hole pair is (Y,Z)=(-8,28) and (+8,28).
       R maps CAD (X,Y,Z) to link7 (Z,-X,-Y); subtract the CAD datum below
       before applying R. This aligns both bolt axes to the selected pair.
       The underside at the bolt axes is CAD Y=13.876550 mm, measured from
       its triangles. With the retained CAD Y datum of 11.9893 mm, joint
       X=-35.917740 mm seats this underside at link7 X=-37.80499 mm.
       The underside has a small slope; contact is aligned at the bolt axes.
       This is a mesh-based placement, not a measured optical calibration.
       The d405_* optical transforms still need D435-specific calibration;
       their old names are retained for consumers.
  -->
  <xacro:property name="d435_mount_cad_x" value="0.051870518"/>
  <xacro:property name="d435_mount_cad_y" value="0.0119893"/>
  <xacro:property name="d435_mount_cad_z" value="0.039075"/>
  <xacro:property name="payload_com_x" value="${(camera_mass * payload['camera_com_cad'][0] + bracket_mass * payload['bracket_com_cad'][0]) / payload_mass - d435_mount_cad_x}"/>
  <xacro:property name="payload_com_y" value="${(camera_mass * payload['camera_com_cad'][1] + bracket_mass * payload['bracket_com_cad'][1]) / payload_mass - d435_mount_cad_y}"/>
  <xacro:property name="payload_com_z" value="${(camera_mass * payload['camera_com_cad'][2] + bracket_mass * payload['bracket_com_cad'][2]) / payload_mass - d435_mount_cad_z}"/>

  <joint name="d405_payload_joint" type="fixed">
    <origin xyz="-0.035917740 0.0 ${0.028 + float(payload['mount_offset_z'])}"
            rpy="${pi} ${-pi/2} ${-pi/2}"/>
    <parent link="link7"/>
    <child link="d405_payload_link"/>
  </joint>

  <link name="d405_payload_link">
    <visual>
      <origin xyz="${-d435_mount_cad_x} ${-d435_mount_cad_y} ${-d435_mount_cad_z}" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://om6dof_description/meshes/d435_wrist_cam.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="white"/>
    </visual>
    <!-- Exact final-path validation uses the same fused bracket+D435 mesh.
         The fast online reachability filter still uses conservative capsules,
         so this triangle mesh is evaluated only for shortlisted paths. -->
    <collision>
      <origin xyz="${-d435_mount_cad_x} ${-d435_mount_cad_y} ${-d435_mount_cad_z}" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://om6dof_description/meshes/d435_wrist_cam.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <xacro:if value="${payload_mass > 0.0}">
      <!-- Sphere approximation only, not a calibrated dynamic inertia tensor. -->
      <xacro:property name="payload_i"
                      value="${0.4 * payload_mass * float(payload['inertia_radius'])**2}"/>
      <inertial>
        <origin xyz="${payload_com_x} ${payload_com_y} ${payload_com_z}"
                rpy="0 0 0"/>
        <mass value="${payload_mass}"/>
        <inertia ixx="${payload_i}" ixy="0.0" ixz="0.0"
                 iyy="${payload_i}" iyz="0.0" izz="${payload_i}"/>
      </inertial>
    </xacro:if>
  </link>

  <!-- Legacy D405 optical transforms retained for existing consumers.
       These values describe the former D405 assembly, not the D435 mesh above.
       The original derivation remains in om6dof.urdf.xacro. Calibrate the D435
       housing-to-optical transform before using these frames for perception.
  -->
  <joint name="d405_link_joint" type="fixed">
    <origin xyz="0.010093 0.047231 0.000046" rpy="-1.134465 1.570590 -1.570798"/>
    <parent link="d405_payload_link"/>
    <child link="d405_link"/>
  </joint>
  <link name="d405_link"/>

  <joint name="d405_depth_optical_joint" type="fixed">
    <!-- Legacy D405 depth offset; not calibrated for the D435. -->
    <origin xyz="0 0 -0.0037" rpy="0 0 ${pi}"/>
    <parent link="d405_link"/>
    <child link="d405_depth_optical_frame"/>
  </joint>
  <link name="d405_depth_optical_frame"/>

</robot>
