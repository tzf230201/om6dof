[Unit]
Description=OM6DOF hardware + command converter on Jetson AGX
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kublab
Group=dialout
Environment=HOME=/home/kublab
Environment=RMW_IMPLEMENTATION=rmw_fastrtps_cpp
# controller_manager promotes only its control-loop thread to FIFO priority 50.
# Grant that thread enough RT/memory-lock headroom without making this whole
# launch service real-time (do not set CPUSchedulingPolicy here).
LimitRTPRIO=60
LimitMEMLOCK=infinity
# The AGX owns U2D2, ros2_control, and om6dof_controller. The input adapter
# receives one selected source and is the only controller-input conversion
# path to the canonical ROS command topics.
# JOINT/CARTESIAN/CYLINDRICAL all resolve in om6dof_controller; no second
# process ever opens U2D2 or publishes final arm positions.
# teleop_node imports unitree_go.msg unconditionally (LowState,
# WirelessController), so this workspace's setup.bash is not enough --
# unitree_go only lives in the separate ~/unitree_ros2/cyclonedds_ws.
# Sourcing its install/setup.bash puts the message python bindings on
# PYTHONPATH without touching RMW_IMPLEMENTATION or CYCLONEDDS_URI (that
# workspace's own setup.sh sets both to CycloneDDS; its colcon-generated
# install/setup.bash does neither), so this unit stays on FastRTPS with
# CYCLONEDDS_URI unset, exactly as before.
ExecStart=/bin/bash -c 'set -e; source /opt/ros/humble/setup.bash; source /home/kublab/ros2_ws/install/setup.bash; source /home/kublab/unitree_ros2/cyclonedds_ws/install/setup.bash; unset CYCLONEDDS_URI; exec ros2 launch om6dof_teleop full_stack.launch.py start_go2w_teleop:=true input_source:=gamepad'
KillMode=control-group
KillSignal=SIGINT
TimeoutStopSec=20
# A communication fail-safe intentionally exits the stack. Keep it stopped
# until the operator uses the web GUI restart button or systemctl restart.
Restart=no

[Install]
WantedBy=multi-user.target
