 import numpy as np
 
 EDGES = [(0,1),(1,2),(2,3),(3,0),(4,5),(5,6),(6,7),(7,4),(0,4),(1,5),(2,6),(3,7)]
+
+
+def up_from_camera_quaternion(xyzw):
+    """World +Z expressed in camera axes from a world-from-camera quaternion."""
+    q=np.asarray(xyzw,dtype=float)
+    if q.shape!=(4,) or not np.isfinite(q).all() or np.linalg.norm(q)<1e-8:
+        raise ValueError('Invalid camera TF quaternion')
+    x,y,z,w=q/np.linalg.norm(q)
+    return np.array([2*(x*z-w*y),2*(y*z+w*x),1-2*(x*x+y*y)],dtype=np.float32)
+
+
+def select_gravity_source(requested, accel_rates):
+    if requested not in ('auto','imu','tf'):raise ValueError('Invalid gravity source')
+    if requested=='imu' and not accel_rates:
+        raise ValueError('This device exposes no accelerometer stream; use gravity_source:=tf with real joint states')
+    return 'imu' if requested!='tf' and accel_rates else 'tf'
+
+
+def rgb_distortion_supported(model_name, coefficients):
+    coefficients=np.asarray(coefficients,dtype=float)
+    if not np.isfinite(coefficients).all():return False
+    return model_name in ('distortion.none','distortion.brown_conrady','distortion.modified_brown_conrady') or (
+        model_name=='distortion.inverse_brown_conrady' and np.all(coefficients==0.))
 
 
