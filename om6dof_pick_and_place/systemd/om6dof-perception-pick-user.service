[Unit]
Description=OM6DOF perception-driven MoveIt pickup backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=HOME=/home/kublab
ExecStart=/bin/bash -c 'set -e; source /opt/ros/humble/setup.bash; source /home/kublab/ros2_ws/install/setup.bash; unset CYCLONEDDS_URI; exec ros2 launch om6dof_pick_and_place perception_pick.launch.py'
KillMode=control-group
KillSignal=SIGINT
TimeoutStopSec=20
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
