Panels:
  - Class: rviz_common/Displays
    Help Height: 70
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /TF1
      Splitter Ratio: 0.5
    Tree Height: 795
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.029999999329447746
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 10
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
        d405_depth_optical_frame:
          Value: true
        d405_link:
          Value: true
        d405_payload_link:
          Value: true
        end_effector_link:
          Value: true
        gripper_left_link:
          Value: true
        gripper_right_link:
          Value: true
        link1:
          Value: true
        link2:
          Value: true
        link3:
          Value: true
        link4:
          Value: true
        link5:
          Value: true
        link6:
          Value: true
        link7:
          Value: true
        world:
          Value: true
      Marker Scale: 0.30000001192092896
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Tree:
        world:
          link1:
            link2:
              link3:
                link4:
                  link5:
                    link6:
                      link7:
                        d405_payload_link:
                          d405_link:
                            d405_depth_optical_frame:
                              {}
                        end_effector_link:
                          {}
                        gripper_left_link:
                          {}
                        gripper_right_link:
                          {}
      Update Interval: 0
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/RobotModel
      Collision Enabled: false
      Description File: ""
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Enabled: true
      Links:
        All Links Enabled: true
        Expand Joint Details: false
        Expand Link Details: false
        Expand Tree: false
        Link Tree Style: Links in Alphabetic Order
        d405_depth_optical_frame:
          Alpha: 1
          Show Axes: false
          Show Trail: false
        d405_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
        d405_payload_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        end_effector_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        gripper_left_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        gripper_right_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        link1:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        link2:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        link3:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        link4:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        link5:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        link6:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        link7:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        world:
          Alpha: 1
          Show Axes: false
          Show Trail: false
      Mass Properties:
        Inertia: false
        Mass: false
      Name: RobotModel
      TF Prefix: ""
      Update Interval: 0
      Value: true
      Visual Enabled: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: environment_graph
      Namespaces:
        environment_graph_edges: true
        environment_graph_nodes: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /om6dof_topo_gng/environment_graph
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: robot_graph
      Namespaces:
        robot_graph_edges: true
        robot_graph_nodes: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /om6dof_topo_gng/robot_graph
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: reachability_graph
      Namespaces:
        reachability_edges: true
        reachability_goal: true
        reachability_nodes: true
        reachability_path: true
        reachability_start: true
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /om6dof_topo_gng/reachability_graph
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 255; 220; 20
      Enabled: true
      Head Diameter: 0.03
      Head Length: 0.03
      Length: 0.03
      Line Style: Lines
      Line Width: 0.01
      Name: reachability_path
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Color: 255; 85; 255
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0.01
      Shaft Length: 0.03
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /om6dof_topo_gng/reachability_path
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Transformation:
