[Unit]
Description=OM6DOF DD-GNG YOLO semantic-node web stream
After=network-online.target
Wants=network-online.target
Conflicts=om6dof-perception.service om6dof-perception-pick.service

[Service]
Type=simple
Environment=HOME=/home/kublab
Environment=PYTHONUNBUFFERED=1
Environment=OM6DOF_MODEL_VERSION=v1
Environment=OM6DOF_CAMERA_MODEL=auto
ExecStart=/bin/bash -lc 'set -e; source /opt/ros/humble/setup.bash; source /home/kublab/ros2_ws/install/setup.bash; unset CYCLONEDDS_URI; exec ros2 launch om6dof_dd_gng dd_gng_yolo.launch.py model_version:=${OM6DOF_MODEL_VERSION} camera_model:=${OM6DOF_CAMERA_MODEL} headless:=true'
KillMode=control-group
KillSignal=SIGINT
TimeoutStopSec=15
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
