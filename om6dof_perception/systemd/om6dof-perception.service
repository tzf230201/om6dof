[Unit]
Description=OM6DOF RealSense perception and web overlay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kublab
Group=video
Environment=HOME=/home/kublab
ExecStart=/bin/bash -c 'set -e; source /opt/ros/humble/setup.bash; source /home/kublab/ros2_ws/install/setup.bash; unset CYCLONEDDS_URI; exec ros2 launch om6dof_perception perception.launch.py'
KillMode=control-group
KillSignal=SIGINT
TimeoutStopSec=15
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
