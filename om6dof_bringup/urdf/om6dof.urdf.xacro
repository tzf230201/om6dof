<?xml version="1.0"?>
<robot name="om6dof" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="port_name" default="/dev/ttyUSB0"/>
  <xacro:arg name="baud_rate" default="1000000"/>
  <xacro:arg name="use_fake_hardware" default="false"/>
  <!-- Off by default: position command interface, arm Mode 5 with stored current limits.
       True selects the separate description exposing effort;
       teaching/impedance explicitly select Mode 0 with zero initial current. -->
  <xacro:arg name="current_control" default="false"/>
  <!-- 5 retains the Dynamixel position loop; supervised READY preparation uses 3.
       Mode 0 requires current_control=true to expose the effort interface. -->
  <xacro:arg name="arm_operating_mode" default="5"/>
  <xacro:arg name="gravity_current_budget" default="false"/>
  <!-- Internal fail-closed profile used only by torque_off_diagnostic.launch.py.
       The driver treats this as an invariant: it forces torque off and rejects
       every ROS path that could turn it back on. -->
  <xacro:arg name="torque_off_diagnostic_mode" default="false"/>

  <xacro:if value="$(arg gravity_current_budget)">
    <xacro:if value="$(arg current_control)">
      <xacro:property name="invalid_budget_profile" lazy_eval="false"
        value="${xacro.fatal('gravity_current_budget requires current_control=false; preserve existing PID')}"/>
    </xacro:if>
    <xacro:unless value="${int('$(arg arm_operating_mode)') == 5}">
      <xacro:property name="invalid_budget_mode" lazy_eval="false"
        value="${xacro.fatal('gravity_current_budget requires Mode 5')}"/>
    </xacro:unless>
    <xacro:if value="$(arg torque_off_diagnostic_mode)">
      <xacro:property name="invalid_budget_diagnostic" lazy_eval="false"
        value="${xacro.fatal('gravity_current_budget cannot be used in diagnostic mode')}"/>
    </xacro:if>
  </xacro:if>

  <!-- Runtime communication fail-safe settings are kept in one editable file. -->
  <xacro:property name="hardware_safety"
    value="${xacro.load_yaml('$(find om6dof_bringup)/config/hardware_safety.yaml')}"/>

  <!-- The physical arm uses the v2 link3 mounting geometry. Keep the
       robot_state_publisher/controller_manager model aligned with MoveIt,
       direct pick, and Gemini pick. -->
  <xacro:include filename="$(find om6dof_description)/urdf/om6dof_v2.urdf.xacro"/>
  <!-- Exactly one of these: both define om6dof_ros2_control, so including
       both would redefine the macro. -->
  <xacro:unless value="$(arg current_control)">
    <xacro:include filename="$(find om6dof_bringup)/urdf/om6dof.ros2_control.xacro"/>
  </xacro:unless>
  <xacro:if value="$(arg current_control)">
    <xacro:include filename="$(find om6dof_bringup)/urdf/om6dof.ros2_control.current.xacro"/>
  </xacro:if>

  <xacro:om6dof_ros2_control
    name="OM6DOFSystem"
    port_name="$(arg port_name)"
    baudrate="$(arg baud_rate)"
    consecutive_failure_shutdown_threshold="${hardware_safety['consecutive_failure_shutdown_threshold']}"
    read_packet_timeout_ms="${hardware_safety['read_packet_timeout_ms']}"
    read_transport_mode="${hardware_safety['read_transport_mode']}"
    use_fake_hardware="$(arg use_fake_hardware)"
    gravity_current_budget="$(arg gravity_current_budget)"
    arm_operating_mode="$(arg arm_operating_mode)"
    torque_off_diagnostic_mode="$(arg torque_off_diagnostic_mode)"/>
</robot>
